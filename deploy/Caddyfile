{
    log default {
        # Error-level HTTP request logs can contain URI bearer tokens even without access logging.
        exclude http.log.access http.log.error
    }
}

{$FUMA_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    # Do not enable access logs: download paths contain bearer grants.
    @diagnostics path /api/docs* /api/openapi.json
    handle @diagnostics {
        respond "Not found" 404
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/fuma
        try_files {path} /index.html
        file_server
    }
}
