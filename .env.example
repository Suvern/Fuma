# Fuma 配置模板：复制为 .env 后填写；不要提交真实 .env。
# 本地启动见 docs/development.md，生产部署见 docs/deployment.md。
# 密码直接填写原文，不需要 URL 编码；含 #、$ 或空格时用单引号包住整个值。

# PostgreSQL：主机、端口、数据库名（不是业务表名）、用户名、密码。
FUMA_DATABASE_HOST=127.0.0.1
FUMA_DATABASE_PORT=55432
FUMA_DATABASE_NAME=fuma
FUMA_DATABASE_USER=fuma
FUMA_DATABASE_PASSWORD=
# 仅本机隔离 trust 数据库允许留空；带密码的数据库必须填写现有密码。

# Redis：主机、端口、逻辑数据库编号、ACL 用户名、密码。
FUMA_REDIS_HOST=127.0.0.1
FUMA_REDIS_PORT=56379
FUMA_REDIS_DB=0
FUMA_REDIS_USERNAME=
FUMA_REDIS_PASSWORD=
# 普通 Redis 用户名可留空；使用 ACL 时填写用户名，例如 default。

FUMA_SITE_URL=http://127.0.0.1:5173
FUMA_COOKIE_SECURE=false
FUMA_SESSION_TTL_SECONDS=28800
FUMA_CACHE_DIR=~/.local/share/fuma/cache
# 持久状态目录：加密密钥自动生成到这里，API / Worker 共用，需随数据库备份。
FUMA_STATE_DIR=~/.local/share/fuma/state

# 无需配置初始化令牌或加密密钥。
# 首次 API 启动自动创建 admin；随机初始密码只在创建时输出到 API 日志。
# 首次登录必须修改密码；重启不重置密码，不再次输出。

# 以下仅用于生产 Docker Compose。
FUMA_DOMAIN=
FUMA_IMAGE_TAG=local
# Compose 要求上方两项 PASSWORD 均非空；自动使用容器内主机、端口。
# PostgreSQL 使用上方 NAME / USER / PASSWORD；Redis 使用 default 用户及上方密码。
# 状态固定保存到 instance_state 卷（/data/state），不要删除该卷。
# 修改配置不会自动更改已有 PostgreSQL 卷中的用户、数据库或密码。

# 兼容旧 FUMA_DATABASE_URL / FUMA_REDIS_URL；设置旧 URL 时优先使用旧 URL。
# 改用分字段配置请删除 .env 中旧 URL 变量，避免覆盖新字段。
# GitHub PAT 和飞书 App Secret 在管理后台输入，不填入此文件。
